# 复制为 .env 后再启动。正式部署务必替换下面两个密码。
MYSQL_PASSWORD=replace_with_a_long_random_password
MYSQL_ROOT_PASSWORD=replace_with_another_long_random_password

# 单管理员登录。仅限本机临时使用时可设为 false；对外或内网共享必须保持 true。
APP_AUTH_ENABLED=true
# 密码至少 12 个字符，正式部署请使用独立随机密码。
APP_AUTH_USERNAME=admin
APP_AUTH_PASSWORD=replace_with_a_long_random_admin_password

# 默认只允许本机访问；需要内网共享时再改为 0.0.0.0，并配置防火墙或反向代理。
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
MYSQL_PORT=3306

APP_OPERATOR=系统
# 只有 HTTPS 部署时设为 true。
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
